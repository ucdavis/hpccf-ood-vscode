#!/usr/bin/env bash

#
# Start Code Server.
#

# Print compute node.
echo "$(date): Running on compute node ${host}:$port"

setup_env() {

  <%- unless context.modules.blank? -%>
  # Purge the module environment to avoid conflicts
  module purge

  # Load the require modules
  module load <%= context.modules %> <%= context.extra_modules %>

  # List loaded modules
  module list
  <%- end -%>
}

setup_env

echo "$(date): Started code-server"
echo ""

code-server \
  --user-data-dir="$DATADIR" \
  --extensions-dir="$DATADIR/extensions" \
<%= context.path.to_s %>
